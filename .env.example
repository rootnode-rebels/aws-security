# ============================================================================
# AWSSecurity AI - Environment Configuration Template
# ============================================================================
# Copy this file to .env and configure values for your deployment environment.

# ----------------------------------------------------------------------------
# Deployment & Server Settings
# ----------------------------------------------------------------------------
DEPLOYMENT_MODE=DEVELOPMENT
HOST=127.0.0.1
PORT=8000

# Additional custom CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ----------------------------------------------------------------------------
# Super Admin Credentials (Configure your secure master admin credentials here)
# ----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=superadmin@awssecurity.io
SUPER_ADMIN_PASSWORD=SuperAdmin#SecurePassword2026!

# ----------------------------------------------------------------------------
# Database Settings
# ----------------------------------------------------------------------------
# Leave blank to use the local atomic JSON document store (data/db.json)
# Or provide a MongoDB connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/aws_security?retryWrites=true&w=majority
MONGODB_URI=

# ----------------------------------------------------------------------------
# AWS Cloud Services Configuration (Amazon SNS / SES / CloudWatch)
# ----------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Amazon SNS Topic ARN for real-time security alerts and step-up MFA codes
SECURITY_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:AccountHijackSecurityAlerts

# ----------------------------------------------------------------------------
# Email Delivery Settings (SMTP / Google Workspace / Gmail App Password)
# ----------------------------------------------------------------------------
# For Gmail: Use smtp.gmail.com, port 587, your email, and a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=security@awssecurity.io

# Cooldown period (in seconds) between duplicate security alert dispatches
NOTIFICATION_COOLDOWN_SECONDS=300

# Serverless Lambda mock authentication (leave false in production)
ENABLE_LAMBDA_MOCK_AUTH=false
